# =========================================================
# Secure Cloud File Sharing System - Environment Variables
# =========================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ---------------------------------------------------------
# MySQL Database
# ---------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=secure_cloud_db

# ---------------------------------------------------------
# Amazon S3 / Compatible Object Storage
# ---------------------------------------------------------
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-secure-bucket-name

# ---------------------------------------------------------
# JWT / Session Security
# ---------------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_secret_string_min_64_chars

# ---------------------------------------------------------
# Application Security
# ---------------------------------------------------------
# Used to encrypt stored RSA private keys in the database
APPLICATION_SECRET=change_this_to_another_long_random_secret_string

# ---------------------------------------------------------
# Email (SMTP) for Member Invitations
# ---------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=Secure Cloud <your_email@gmail.com>

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
NODE_ENV=production
PORT=5000
APP_URL=https://your-app.onrender.com
