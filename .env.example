# =========================================================
# Secure Cloud Crypto — Environment Variables
# =========================================================
# Copy this file to .env and fill in values for local dev.
# For Render deployment, set these in the Dashboard.
# NEVER commit .env to version control.

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
NODE_ENV=production
PORT=5000
APP_URL=https://your-app.onrender.com

# ---------------------------------------------------------
# Authentication (REQUIRED — change these!)
# ---------------------------------------------------------
# JWT signing secret — minimum 32 characters, random string
JWT_SECRET=change-this-to-a-long-random-secret-minimum-32-chars

# One-time admin bootstrap token — used ONCE to create first admin
# After first admin is created, this env var can be removed.
ADMIN_SETUP_TOKEN=change-this-to-a-random-setup-token

# ---------------------------------------------------------
# Private Key Encryption (for future key storage feature)
# ---------------------------------------------------------
APPLICATION_SECRET=change-this-to-another-long-random-secret
